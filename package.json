{
  "name": "precise-formulations",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply precise-formulations-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply precise-formulations-db --remote",
    "db:seed:local": "wrangler d1 execute precise-formulations-db --local --file=./db/seed.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/react": "^7.1.5",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.8",
    "drizzle-orm": "^0.45.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "wrangler": "^4.160.0"
  }
}

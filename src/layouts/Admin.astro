---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const adminEmail = Astro.locals.adminEmail;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Libre+Caslon+Display&display=swap" />
    <title>{title} — Precise Formulations admin</title>
  </head>
  <body class="min-h-dvh bg-paper text-ink">
    <header class="border-b border-ink/80">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
        <a href="/admin" class="text-lg font-semibold tracking-tight">Precise Formulations <span class="font-normal text-ink-muted">· Orders</span></a>
        <div class="flex items-center gap-4 text-sm text-ink-muted">
          {adminEmail && adminEmail !== "local-dev" && <span class="hidden sm:inline">{adminEmail}</span>}
          {adminEmail === "local-dev" && <span class="bg-band px-2 py-1">Local dev, no sign-in</span>}
          <a href="/" class="hover:text-accent">View site</a>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <slot />
    </main>
  </body>
</html>

---
import Admin from "../../../layouts/Admin.astro";
import StatusBadge from "../../../components/admin/StatusBadge.astro";
import { getOrder } from "../../../lib/admin-orders";
import { REMINDER_DELAYS_MINUTES, SHIPPING_RATES, TRACKING_URL, formatAdminDate, formatPrice } from "../../../lib/store-config";

const orderNumber = (Astro.params.orderNumber ?? "").toUpperCase();
const found = await getOrder(orderNumber);
if (!found) return new Response("Order not found", { status: 404 });
const { order, items } = found;

const flash = {
  ok: Astro.url.searchParams.get("ok"),
  warn: Astro.url.searchParams.get("warn"),
  error: Astro.url.searchParams.get("error"),
};
const action = `/api/admin/orders/${order.orderNumber}`;

const timeline = [
  ["Placed", order.createdAt],
  ...(order.remindersSent ? [[`${order.remindersSent} of ${REMINDER_DELAYS_MINUTES.length} payment reminders sent`, order.lastReminderAt] as const] : []),
  ["Marked paid", order.paidAt],
  ["Shipped", order.shippedAt],
  ["Cancelled", order.cancelledAt],
].filter(([, d]) => d) as [string, Date][];
---

<Admin title={order.orderNumber}>
  <a href="/admin" class="text-sm text-ink-muted hover:text-accent">← All orders</a>

  <div class="mt-3 flex flex-wrap items-center gap-4">
    <h1 class="display text-[2.5rem]">{order.orderNumber}</h1>
    <StatusBadge status={order.status} />
  </div>

  {flash.ok && <p class="mt-4 border-l-4 border-accent bg-band px-4 py-3" role="status">{flash.ok}</p>}
  {flash.warn && <p class="mt-4 border-l-4 border-ink bg-band px-4 py-3 font-semibold" role="status">{flash.warn}</p>}
  {flash.error && <p class="mt-4 border-l-4 border-red-700 bg-band px-4 py-3 text-red-800" role="alert">{flash.error}</p>}

  <div class="mt-8 grid gap-10 lg:grid-cols-[3fr_2fr]">
    <div>
      <!-- Next step for this order -->
      <section class="bg-band p-6">
        {order.status === "pending" && (
          <>
            <h2 class="text-lg font-semibold">Waiting for {formatPrice(order.totalCents)}</h2>
            <p class="mt-1 text-ink-muted">Look for a Venmo or Zelle payment with <strong class="text-ink">{order.orderNumber}</strong> in the memo, then mark it as paid. The customer gets a confirmation email.</p>
            <div class="mt-5 flex flex-wrap gap-3">
              <form method="post" action={action}>
                <input type="hidden" name="action" value="mark-paid" />
                <button class="btn-primary">Mark as paid</button>
              </form>
              <form method="post" action={action} data-confirm={`Cancel ${order.orderNumber}? The customer will get a cancellation email. This can't be undone.`}>
                <input type="hidden" name="action" value="cancel" />
                <button class="border border-ink px-6 py-3 font-semibold">Cancel order</button>
              </form>
            </div>
          </>
        )}
        {order.status === "paid" && (
          <>
            <h2 class="text-lg font-semibold">Ready to ship</h2>
            <p class="mt-1 text-ink-muted">Enter the tracking number and mark it as shipped. The customer gets an email with the tracking number.</p>
            <form method="post" action={action} class="mt-5 flex flex-wrap gap-3">
              <input type="hidden" name="action" value="mark-shipped" />
              <label class="flex-1">
                <span class="sr-only">Tracking number</span>
                <input name="trackingNumber" required minlength="8" placeholder="Tracking number" autocomplete="off" class="w-full min-w-56 border border-ink/30 bg-paper px-3 py-3 outline-none focus:border-accent" />
              </label>
              <button class="btn-primary">Mark as shipped</button>
            </form>
          </>
        )}
        {order.status === "shipped" && (
          <>
            <h2 class="text-lg font-semibold">Shipped</h2>
            <p class="mt-1">
              Tracking: <a href={TRACKING_URL(order.trackingNumber ?? "")} target="_blank" rel="noopener" class="font-semibold text-accent underline">{order.trackingNumber}</a>
            </p>
            <details class="mt-4">
              <summary class="cursor-pointer text-sm text-ink-muted">Correct the tracking number</summary>
              <form method="post" action={action} class="mt-3 flex flex-wrap gap-3">
                <input type="hidden" name="action" value="update-tracking" />
                <input name="trackingNumber" required minlength="8" placeholder="Corrected tracking number" autocomplete="off" class="flex-1 border border-ink/30 bg-paper px-3 py-2 outline-none focus:border-accent" />
                <button class="border border-ink px-4 py-2 font-semibold">Update and email customer</button>
              </form>
            </details>
          </>
        )}
        {order.status === "cancelled" && (
          <>
            <h2 class="text-lg font-semibold">Cancelled</h2>
            <p class="mt-1 text-ink-muted">This order was cancelled and the customer was emailed.</p>
          </>
        )}
      </section>

      <h2 class="mt-10 text-lg font-semibold">Items</h2>
      <dl class="mt-3">
        {items.map((i) => (
          <div class="ruled-row"><dt>{i.name} × {i.quantity}</dt><dd class="tabular-nums">{formatPrice(i.unitPriceCents * i.quantity)}</dd></div>
        ))}
        <div class="ruled-row"><dt>{SHIPPING_RATES[order.shippingMethod].label} shipping ({SHIPPING_RATES[order.shippingMethod].eta})</dt><dd class="tabular-nums">{formatPrice(order.shippingCents)}</dd></div>
        <div class="ruled-row border-b font-semibold"><dt>Total</dt><dd class="tabular-nums">{formatPrice(order.totalCents)}</dd></div>
      </dl>
    </div>

    <aside class="space-y-8">
      <section>
        <h2 class="text-lg font-semibold">Customer</h2>
        <p class="mt-2">{order.customerName}<br /><a href={`mailto:${order.email}`} class="text-accent underline">{order.email}</a></p>
      </section>

      <section>
        <h2 class="text-lg font-semibold">Ship to</h2>
        {!order.addressVerified && (
          <p class="mt-2 border border-ink px-3 py-2 text-sm font-semibold">Address not verified by USPS. Check it before shipping.</p>
        )}
        <p class="mt-2">
          {order.customerName}<br />
          {order.addressLine1}{order.addressLine2 && <><br />{order.addressLine2}</>}<br />
          {order.city}, {order.state} {order.zip}
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold">History</h2>
        <ol class="mt-2 text-sm">
          {timeline.map(([label, date]) => (
            <li class="flex justify-between gap-4 border-t border-rule py-2"><span>{label}</span><span class="text-ink-muted whitespace-nowrap">{formatAdminDate(date)}</span></li>
          ))}
        </ol>
      </section>
    </aside>
  </div>

  <script>
    // Ask before irreversible actions; disable buttons after submit to avoid double clicks
    document.querySelectorAll<HTMLFormElement>("form[method=post]").forEach((form) => {
      form.addEventListener("submit", (e) => {
        const msg = form.dataset.confirm;
        if (msg && !window.confirm(msg)) {
          e.preventDefault();
          return;
        }
        form.querySelectorAll("button").forEach((b) => ((b as HTMLButtonElement).disabled = true));
      });
    });
  </script>
</Admin>

---
import Base from "../layouts/Base.astro";

// Phase 3: checkout. ?product=<slug> pre-fills the order from the homepage button.
const preselected = Astro.url.searchParams.get("product");
---

<Base title="Your order — Precise Formulations" variant="checkout">
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="display text-[2.5rem]">Order</h1>
    <p class="mt-4 text-ink-muted">Checkout is built in Phase 3. Pre-selected product: {preselected ?? "none"}</p>
  </section>
</Base>
